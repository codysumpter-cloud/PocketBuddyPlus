{
  "manifestVersion": 3,
  "id": "openpets.buddy-cloud",
  "name": "Buddy Cloud",
  "description": "Secure Supabase backup, durable memory, recall, and mission access for your canonical Pocket Buddy+ profile.",
  "version": "1.0.0",
  "runtime": "javascript",
  "icon": "sparkles",
  "sdkVersion": "3.0.0",
  "entry": "index.js",
  "permissions": [
    "pets:read",
    "schedule",
    "storage",
    "secrets",
    "commands",
    "status",
    "ui:toast",
    "ui:panel",
    "network",
    "network:write"
  ],
  "network": {
    "hosts": [
      "uipxgyzvcrxjfcidvsbl.supabase.co"
    ]
  },
  "panels": {
    "connect": "connect.html"
  }
}
