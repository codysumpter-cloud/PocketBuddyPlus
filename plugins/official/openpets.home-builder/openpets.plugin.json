{
  "manifestVersion": 3,
  "id": "openpets.home-builder",
  "name": "$t:plugin.name",
  "description": "$t:plugin.description",
  "version": "1.1.0",
  "runtime": "javascript",
  "icon": "home",
  "sdkVersion": "3.0.0",
  "entry": "index.js",
  "permissions": [
    "commands",
    "files",
    "storage",
    "ui:panel",
    "pets:read",
    "pets:manage",
    "pet:reaction"
  ],
  "panels": {
    "home": "home.html"
  }
}
